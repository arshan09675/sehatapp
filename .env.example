# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings → API). NEVER commit real values.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical origin for absolute URLs in page metadata, robots.txt and the
# sitemap. Set this per deployment; falls back to https://sehatbook.pk.
NEXT_PUBLIC_SITE_URL=https://sehatbook.pk

# Server-only. Bypasses RLS — used exclusively by src/lib/supabase/admin.ts
# inside admin server actions and by src/lib/notify (the notifications table
# has no INSERT policy). Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Notifications (Phase 5) -------------------------------------------------

# Which driver src/lib/notify sends through. `console` prints the message
# instead of sending it; real providers register in src/lib/notify/send.ts.
NOTIFY_DRIVER=console

# Bearer token guarding /api/cron/reminders. Vercel Cron sends it automatically
# once this is set in the project's environment variables; generate one with
# `openssl rand -hex 32`. The route refuses to run when it is missing.
CRON_SECRET=

# How far ahead the reminder goes out, and how wide a slice each run sweeps.
# The width should match the cron interval in vercel.json (hourly) so
# consecutive runs tile without a gap. Defaults are used when unset.
REMINDER_LEAD_MINUTES=180
REMINDER_WINDOW_MINUTES=60

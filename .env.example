# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings → API). NEVER commit real values.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — used exclusively by src/lib/supabase/admin.ts
# inside admin server actions. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
